<odoo>
    <!-- Usuarios internos y de portal: solo ven los servicios que son suyos. -->
    <record id="whatsapp_qr_rule_propios" model="ir.rule">
        <field name="name">WhatsApp QR: cada usuario ve solo lo suyo</field>
        <field name="model_id" ref="model_whatsapp_qr"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('base.group_portal'))]"/>
    </record>
    <!-- Administradores: ven y gestionan todos (las reglas de grupo se suman). -->
    <record id="whatsapp_qr_rule_admin" model="ir.rule">
        <field name="name">WhatsApp QR: administradores ven todo</field>
        <field name="model_id" ref="model_whatsapp_qr"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
